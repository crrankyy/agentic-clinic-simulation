# Copy to .env (which is git-ignored) and fill in.
# The CLI loads .env automatically; nothing here is ever logged.

# Required for every OpenRouter role (D-020).
OPENROUTER_API_KEY=sk-or-v1-...

# The judge uses the Anthropic SDK (D-021, an explicit override of the brief's
# OpenRouter-only rule). Leave unset if you authenticate with `ant auth login`
# instead — the SDK resolves that profile automatically.
# ANTHROPIC_API_KEY=sk-ant-...

# Phase 5 only. NCBI requires a contact address on E-utilities requests; the
# evidence agent is skipped entirely if this is unset (Q-18).
# NCBI_EMAIL=you@example.com
# NCBI_API_KEY=
